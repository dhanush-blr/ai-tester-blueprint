# ── Target Environment ──────────────────────────────────────
# One of: dev, qa, staging
ENVIRONMENT=dev

# ── Base URLs per environment ───────────────────────────────
BASE_URL_DEV=https://api.dev.example.com
BASE_URL_QA=https://api.qa.example.com
BASE_URL_STAGING=https://api.staging.example.com

# ── Authentication ──────────────────────────────────────────
# OAuth2 Client Credentials grant — used by the auth fixture
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_TOKEN_URL=https://auth.example.com/oauth/token

# Optional: hard-coded bearer token for local debugging
# BEARER_TOKEN=eyJhbGci...
